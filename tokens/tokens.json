{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Habits 3-tier DTCG design tokens (primitive, semantic, component). Dark theme, single blue accent. Source of truth for styles/tokens.css.",
  "primitive": {
    "color": {
      "white": { "$type": "color", "$value": "#FFFFFF" },
      "slate": {
        "950": { "$type": "color", "$value": "#07090E" },
        "900": { "$type": "color", "$value": "#0F131C" },
        "875": { "$type": "color", "$value": "#151B26" },
        "850": { "$type": "color", "$value": "#18202C" },
        "800": { "$type": "color", "$value": "#1D2533" },
        "750": { "$type": "color", "$value": "#242E3F" },
        "500": { "$type": "color", "$value": "#64748B" },
        "400": { "$type": "color", "$value": "#7E8FA6" },
        "300": { "$type": "color", "$value": "#9AA8BC" },
        "50":  { "$type": "color", "$value": "#F1F5F9" }
      },
      "blue": {
        "300": { "$type": "color", "$value": "#7DD3FC" },
        "400": { "$type": "color", "$value": "#38BDF8" },
        "700": { "$type": "color", "$value": "#1D588A" },
        "950": { "$type": "color", "$value": "#0C1F33" },
        "990": { "$type": "color", "$value": "#040B14" }
      },
      "indigo": {
        "400": { "$type": "color", "$value": "#818CF8" }
      },
      "emerald": {
        "400": { "$type": "color", "$value": "#34D399" },
        "950": { "$type": "color", "$value": "#0E281E" }
      },
      "rose": {
        "300": { "$type": "color", "$value": "#FDA4AF" },
        "600": { "$type": "color", "$value": "#CF1742" },
        "700": { "$type": "color", "$value": "#B01036" },
        "950": { "$type": "color", "$value": "#2C1218" }
      },
      "amber": {
        "400": { "$type": "color", "$value": "#FBBF24" },
        "950": { "$type": "color", "$value": "#291F0B" }
      }
    },
    "space": {
      "1":  { "$type": "dimension", "$value": "0.25rem" },
      "2":  { "$type": "dimension", "$value": "0.5rem" },
      "3":  { "$type": "dimension", "$value": "0.75rem" },
      "4":  { "$type": "dimension", "$value": "1rem" },
      "5":  { "$type": "dimension", "$value": "1.25rem" },
      "6":  { "$type": "dimension", "$value": "1.5rem" },
      "8":  { "$type": "dimension", "$value": "2rem" },
      "10": { "$type": "dimension", "$value": "2.5rem" },
      "12": { "$type": "dimension", "$value": "3rem" },
      "16": { "$type": "dimension", "$value": "4rem" }
    },
    "radius": {
      "sm":   { "$type": "dimension", "$value": "0.5rem" },
      "md":   { "$type": "dimension", "$value": "0.75rem" },
      "lg":   { "$type": "dimension", "$value": "1rem" },
      "xl":   { "$type": "dimension", "$value": "1.25rem" },
      "2xl":  { "$type": "dimension", "$value": "1.5rem" },
      "full": { "$type": "dimension", "$value": "999px" }
    },
    "font": {
      "sans": { "$type": "fontFamily", "$value": ["Geist", "system-ui", "-apple-system", "Segoe UI", "sans-serif"] },
      "mono": { "$type": "fontFamily", "$value": ["Geist Mono", "ui-monospace", "SFMono-Regular", "Consolas", "monospace"] }
    },
    "fontSize": {
      "xs":      { "$type": "dimension", "$value": "0.75rem" },
      "sm":      { "$type": "dimension", "$value": "0.8125rem" },
      "base":    { "$type": "dimension", "$value": "0.9375rem" },
      "md":      { "$type": "dimension", "$value": "1rem" },
      "lg":      { "$type": "dimension", "$value": "1.25rem" },
      "xl":      { "$type": "dimension", "$value": "1.625rem" },
      "title":   { "$type": "dimension", "$value": "2.375rem" },
      "display": { "$type": "dimension", "$value": "3rem" },
      "hero":    { "$type": "dimension", "$value": "4rem" }
    },
    "fontWeight": {
      "regular":  { "$type": "fontWeight", "$value": 400 },
      "medium":   { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold":     { "$type": "fontWeight", "$value": 700 }
    },
    "duration": {
      "fast": { "$type": "duration", "$value": "120ms" },
      "base": { "$type": "duration", "$value": "200ms" },
      "slow": { "$type": "duration", "$value": "480ms" }
    },
    "easing": {
      "standard": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] },
      "spring":   { "$type": "cubicBezier", "$value": [0.34, 1.56, 0.64, 1] }
    }
  },
  "semantic": {
    "surface": {
      "page":    { "$type": "color", "$value": "{primitive.color.slate.950}" },
      "card":    { "$type": "color", "$value": "{primitive.color.slate.900}" },
      "raised":  { "$type": "color", "$value": "{primitive.color.slate.875}" },
      "overlay": { "$type": "color", "$value": "{primitive.color.slate.850}" },
      "muted":   { "$type": "color", "$value": "{primitive.color.slate.800}" }
    },
    "text": {
      "primary":   { "$type": "color", "$value": "{primitive.color.slate.50}" },
      "secondary": { "$type": "color", "$value": "{primitive.color.slate.300}" },
      "tertiary":  { "$type": "color", "$value": "{primitive.color.slate.400}" },
      "link":      { "$type": "color", "$value": "{primitive.color.blue.400}" },
      "on-action": { "$type": "color", "$value": "{primitive.color.blue.990}" }
    },
    "border": {
      "default": { "$type": "color", "$value": "{primitive.color.slate.750}" },
      "strong":  { "$type": "color", "$value": "{primitive.color.slate.500}" },
      "accent":  { "$type": "color", "$value": "{primitive.color.blue.700}" },
      "focus":   { "$type": "color", "$value": "{primitive.color.blue.400}" }
    },
    "action": {
      "primary":           { "$type": "color", "$value": "{primitive.color.blue.400}" },
      "primary-hover":     { "$type": "color", "$value": "{primitive.color.blue.300}" },
      "primary-text":      { "$type": "color", "$value": "{primitive.color.blue.990}" },
      "destructive":       { "$type": "color", "$value": "{primitive.color.rose.600}" },
      "destructive-hover": { "$type": "color", "$value": "{primitive.color.rose.700}" },
      "destructive-text":  { "$type": "color", "$value": "{primitive.color.white}" }
    },
    "status": {
      "positive":      { "$type": "color", "$value": "{primitive.color.emerald.400}" },
      "positive-soft": { "$type": "color", "$value": "{primitive.color.emerald.950}" },
      "negative":      { "$type": "color", "$value": "{primitive.color.rose.300}" },
      "negative-soft": { "$type": "color", "$value": "{primitive.color.rose.950}" },
      "warning":       { "$type": "color", "$value": "{primitive.color.amber.400}" },
      "warning-soft":  { "$type": "color", "$value": "{primitive.color.amber.950}" }
    },
    "chart": {
      "line": { "$type": "color", "$value": "{primitive.color.blue.400}" },
      "2":    { "$type": "color", "$value": "{primitive.color.indigo.400}" },
      "3":    { "$type": "color", "$value": "{primitive.color.amber.400}" }
    }
  },
  "component": {
    "control": {
      "height":    { "$type": "dimension", "$value": "2.75rem" },
      "height-sm": { "$type": "dimension", "$value": "2.25rem" },
      "height-lg": { "$type": "dimension", "$value": "3.5rem" }
    },
    "layout": {
      "tabbar-height": { "$type": "dimension", "$value": "4.5rem" },
      "sidebar-width": { "$type": "dimension", "$value": "16rem" },
      "content-max":   { "$type": "dimension", "$value": "78rem" },
      "sheet-max":     { "$type": "dimension", "$value": "32rem" }
    },
    "chart": {
      "height":    { "$type": "dimension", "$value": "11rem" },
      "height-lg": { "$type": "dimension", "$value": "14rem" },
      "ring-size": { "$type": "dimension", "$value": "9rem" },
      "heat-cell": { "$type": "dimension", "$value": "0.8125rem" }
    }
  }
}
