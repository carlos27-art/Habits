{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Habits 3-tier DTCG design tokens (primitive, semantic, component, dark). Source of truth for styles/tokens.css.",
  "primitive": {
    "color": {
      "white": { "$type": "color", "$value": "#FFFFFF" },
      "neutral": {
        "25":  { "$type": "color", "$value": "#F7F7F5" },
        "75":  { "$type": "color", "$value": "#ECECE8" },
        "150": { "$type": "color", "$value": "#DEDDD8" },
        "400": { "$type": "color", "$value": "#8B8B94" },
        "500": { "$type": "color", "$value": "#75757E" },
        "600": { "$type": "color", "$value": "#52525B" },
        "900": { "$type": "color", "$value": "#17171A" }
      },
      "ink": {
        "950": { "$type": "color", "$value": "#0D0E11" },
        "900": { "$type": "color", "$value": "#15171C" },
        "850": { "$type": "color", "$value": "#1E2129" },
        "800": { "$type": "color", "$value": "#2A2E39" },
        "500": { "$type": "color", "$value": "#6B7280" },
        "400": { "$type": "color", "$value": "#7E8594" },
        "300": { "$type": "color", "$value": "#A1A6B3" },
        "100": { "$type": "color", "$value": "#ECEDF0" }
      },
      "indigo": {
        "50":  { "$type": "color", "$value": "#EEF0FF" },
        "300": { "$type": "color", "$value": "#A8ABFF" },
        "600": { "$type": "color", "$value": "#4F46E5" },
        "700": { "$type": "color", "$value": "#4338CA" },
        "800": { "$type": "color", "$value": "#3730A3" },
        "950": { "$type": "color", "$value": "#1E1B4B" }
      },
      "green": {
        "50":  { "$type": "color", "$value": "#E7F6EC" },
        "400": { "$type": "color", "$value": "#4ADE80" },
        "700": { "$type": "color", "$value": "#15803D" },
        "950": { "$type": "color", "$value": "#0B2A17" }
      },
      "red": {
        "50":  { "$type": "color", "$value": "#FDECEC" },
        "300": { "$type": "color", "$value": "#FCA5A5" },
        "700": { "$type": "color", "$value": "#B91C1C" },
        "800": { "$type": "color", "$value": "#991B1B" },
        "950": { "$type": "color", "$value": "#3A1010" }
      },
      "amber": {
        "50":  { "$type": "color", "$value": "#FDF3E2" },
        "400": { "$type": "color", "$value": "#FBBF24" },
        "800": { "$type": "color", "$value": "#92400E" },
        "950": { "$type": "color", "$value": "#33210A" }
      }
    },
    "space": {
      "1":  { "$type": "dimension", "$value": "0.25rem" },
      "2":  { "$type": "dimension", "$value": "0.5rem" },
      "3":  { "$type": "dimension", "$value": "0.75rem" },
      "4":  { "$type": "dimension", "$value": "1rem" },
      "5":  { "$type": "dimension", "$value": "1.25rem" },
      "6":  { "$type": "dimension", "$value": "1.5rem" },
      "8":  { "$type": "dimension", "$value": "2rem" },
      "10": { "$type": "dimension", "$value": "2.5rem" },
      "12": { "$type": "dimension", "$value": "3rem" },
      "16": { "$type": "dimension", "$value": "4rem" }
    },
    "radius": {
      "sm":   { "$type": "dimension", "$value": "0.5rem" },
      "md":   { "$type": "dimension", "$value": "0.75rem" },
      "lg":   { "$type": "dimension", "$value": "1rem" },
      "xl":   { "$type": "dimension", "$value": "1.25rem" },
      "full": { "$type": "dimension", "$value": "999px" }
    },
    "font": {
      "family": {
        "sans": { "$type": "fontFamily", "$value": ["Geist", "system-ui", "-apple-system", "Segoe UI", "sans-serif"] },
        "mono": { "$type": "fontFamily", "$value": ["Geist Mono", "ui-monospace", "SFMono-Regular", "Consolas", "monospace"] }
      },
      "size": {
        "xs":      { "$type": "dimension", "$value": "0.75rem" },
        "sm":      { "$type": "dimension", "$value": "0.8125rem" },
        "base":    { "$type": "dimension", "$value": "0.9375rem" },
        "md":      { "$type": "dimension", "$value": "1rem" },
        "lg":      { "$type": "dimension", "$value": "1.25rem" },
        "xl":      { "$type": "dimension", "$value": "1.625rem" },
        "display": { "$type": "dimension", "$value": "2.75rem" },
        "hero":    { "$type": "dimension", "$value": "3.5rem" }
      }
    },
    "duration": {
      "fast": { "$type": "duration", "$value": "120ms" },
      "base": { "$type": "duration", "$value": "200ms" },
      "slow": { "$type": "duration", "$value": "420ms" }
    },
    "easing": {
      "standard": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] }
    }
  },
  "semantic": {
    "text": {
      "primary":   { "$type": "color", "$value": "{primitive.color.neutral.900}" },
      "secondary": { "$type": "color", "$value": "{primitive.color.neutral.600}" },
      "tertiary":  { "$type": "color", "$value": "{primitive.color.neutral.500}" },
      "on-action": { "$type": "color", "$value": "{primitive.color.white}" },
      "link":      { "$type": "color", "$value": "{primitive.color.indigo.700}" }
    },
    "surface": {
      "page":   { "$type": "color", "$value": "{primitive.color.neutral.25}" },
      "card":   { "$type": "color", "$value": "{primitive.color.white}" },
      "raised": { "$type": "color", "$value": "{primitive.color.white}" },
      "sunken": { "$type": "color", "$value": "{primitive.color.neutral.75}" }
    },
    "border": {
      "default": { "$type": "color", "$value": "{primitive.color.neutral.150}" },
      "strong":  { "$type": "color", "$value": "{primitive.color.neutral.500}" },
      "focus":   { "$type": "color", "$value": "{primitive.color.indigo.700}" },
      "error":   { "$type": "color", "$value": "{primitive.color.red.700}" }
    },
    "action": {
      "primary":           { "$type": "color", "$value": "{primitive.color.indigo.700}" },
      "primary-hover":     { "$type": "color", "$value": "{primitive.color.indigo.800}" },
      "secondary":         { "$type": "color", "$value": "{primitive.color.white}" },
      "secondary-hover":   { "$type": "color", "$value": "{primitive.color.neutral.75}" },
      "destructive":       { "$type": "color", "$value": "{primitive.color.red.700}" },
      "destructive-hover": { "$type": "color", "$value": "{primitive.color.red.800}" }
    },
    "feedback": {
      "positive":      { "$type": "color", "$value": "{primitive.color.green.700}" },
      "positive-soft": { "$type": "color", "$value": "{primitive.color.green.50}" },
      "negative":      { "$type": "color", "$value": "{primitive.color.red.700}" },
      "negative-soft": { "$type": "color", "$value": "{primitive.color.red.50}" },
      "warning":       { "$type": "color", "$value": "{primitive.color.amber.800}" },
      "warning-soft":  { "$type": "color", "$value": "{primitive.color.amber.50}" }
    }
  },
  "component": {
    "control-height": { "$type": "dimension", "$value": "2.75rem" },
    "tabbar-height":  { "$type": "dimension", "$value": "4rem" },
    "sidebar-width":  { "$type": "dimension", "$value": "15rem" },
    "content-max":    { "$type": "dimension", "$value": "76rem" }
  },
  "dark": {
    "text": {
      "primary":   { "$type": "color", "$value": "{primitive.color.ink.100}" },
      "secondary": { "$type": "color", "$value": "{primitive.color.ink.300}" },
      "tertiary":  { "$type": "color", "$value": "{primitive.color.ink.400}" },
      "on-action": { "$type": "color", "$value": "{primitive.color.white}" },
      "link":      { "$type": "color", "$value": "{primitive.color.indigo.300}" }
    },
    "surface": {
      "page":   { "$type": "color", "$value": "{primitive.color.ink.950}" },
      "card":   { "$type": "color", "$value": "{primitive.color.ink.900}" },
      "raised": { "$type": "color", "$value": "{primitive.color.ink.850}" },
      "sunken": { "$type": "color", "$value": "{primitive.color.ink.850}" }
    },
    "border": {
      "default": { "$type": "color", "$value": "{primitive.color.ink.800}" },
      "strong":  { "$type": "color", "$value": "{primitive.color.ink.500}" },
      "focus":   { "$type": "color", "$value": "{primitive.color.indigo.300}" },
      "error":   { "$type": "color", "$value": "{primitive.color.red.300}" }
    },
    "action": {
      "primary":           { "$type": "color", "$value": "{primitive.color.indigo.600}" },
      "primary-hover":     { "$type": "color", "$value": "{primitive.color.indigo.700}" },
      "secondary":         { "$type": "color", "$value": "{primitive.color.ink.900}" },
      "secondary-hover":   { "$type": "color", "$value": "{primitive.color.ink.850}" },
      "destructive":       { "$type": "color", "$value": "{primitive.color.red.700}" },
      "destructive-hover": { "$type": "color", "$value": "{primitive.color.red.800}" }
    },
    "feedback": {
      "positive":      { "$type": "color", "$value": "{primitive.color.green.400}" },
      "positive-soft": { "$type": "color", "$value": "{primitive.color.green.950}" },
      "negative":      { "$type": "color", "$value": "{primitive.color.red.300}" },
      "negative-soft": { "$type": "color", "$value": "{primitive.color.red.950}" },
      "warning":       { "$type": "color", "$value": "{primitive.color.amber.400}" },
      "warning-soft":  { "$type": "color", "$value": "{primitive.color.amber.950}" }
    }
  }
}
